{
  "name": "Backend Environment (Python/Django/uv)",
  "dockerComposeFile": [
    "../../compose.yml",
    "../../compose.dev.yml"
  ],
  // Service name from compose.yml that holds Python app
  "service": "web",
  // Points to workplace folder for Docker - where the terminal starts
  "workspaceFolder": "/workspace",
  // Use non-root user for container (defined in Dockerfile)
  "remoteUser": "nonroot",
  "updateRemoteUserUID": true,
  "portsAttributes": {
    "8000": {
      "onAutoForward": "ignore"
    },
    "5432": {
      "onAutoForward": "ignore"
    }
  },
  // Automate python package installation right after container creation
  "postCreateCommand": "./.scripts/bootstrap.sh",
  // Configure tool-specific properties.
  "customizations": {
    // 1. For VS Code & Cursor users
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "redhat.vscode-yaml",
        "monosans.djlint",
        "editorconfig.editorconfig"
      ],
      "settings": {
        // Workplace file for VS Code sidebar UI
        "workspace.workspaceFolders": [
          {
            "path": "/workspace/backend",
            "name": "Backend App"
          },
          {
            "path": "/workspace",
            "name": "Project Root (Config)"
          }
        ],
        "remote.SSH.enableAgentForwarding": true,
        "python.defaultInterpreterPath": "/workspace/backend/.venv/bin/python",
        "terminal.integrated.cwd": "/workspace/backend",
        "editor.formatOnSave": true,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        },
        "[django-html]": {
          "editor.defaultFormatter": "monosans.djlint"
        },
        "prettier.configPath": "/workspace/.prettierignore"
      }
    },
    // 2. For JetBrains (PyCharm) users
    "jetbrains": {
      "backend": "PyCharm",
      "plugins": [
        "com.jetbrains.python",
        "charliermarsh.ruff",
        "EditorConfig"
      ]
    }
  }
}
